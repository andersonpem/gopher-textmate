{
	"name": "Gopher Dark",
	"type": "dark",
	"colors": {
		"editor.foreground": "#d4d4d4",
		"editor.background": "#1e1e1e"
	},
	"tokenColors": [
		{
			"settings": {
				"foreground": "#d4d4d4"
			}
		},
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"foreground": "#6a9955",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["string", "string.quoted", "string.template"],
			"settings": {
				"foreground": "#ce9178"
			}
		},
		{
			"scope": ["constant.numeric"],
			"settings": {
				"foreground": "#b5cea8"
			}
		},
		{
			"scope": ["constant.language", "constant.character", "constant.other"],
			"settings": {
				"foreground": "#569cd6"
			}
		},
		{
			"scope": ["keyword", "keyword.control", "keyword.operator.new"],
			"settings": {
				"foreground": "#c586c0"
			}
		},
		{
			"scope": ["keyword.operator"],
			"settings": {
				"foreground": "#d4d4d4"
			}
		},
		{
			"scope": ["storage", "storage.type", "storage.modifier"],
			"settings": {
				"foreground": "#569cd6"
			}
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function"],
			"settings": {
				"foreground": "#dcdcaa"
			}
		},
		{
			"scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.name.namespace"],
			"settings": {
				"foreground": "#4ec9b0"
			}
		},
		{
			"scope": ["entity.name.tag"],
			"settings": {
				"foreground": "#569cd6"
			}
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": {
				"foreground": "#9cdcfe"
			}
		},
		{
			"scope": ["variable", "variable.other", "variable.parameter"],
			"settings": {
				"foreground": "#9cdcfe"
			}
		},
		{
			"scope": ["variable.language", "variable.language.this"],
			"settings": {
				"foreground": "#569cd6",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["punctuation", "meta.brace", "punctuation.definition"],
			"settings": {
				"foreground": "#d4d4d4"
			}
		},
		{
			"scope": ["invalid", "invalid.illegal"],
			"settings": {
				"foreground": "#f44747"
			}
		}
	]
}
